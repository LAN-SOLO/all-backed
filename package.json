{
  "name": "all-backed",
  "private": true,
  "version": "1.0.0",
  "description": "all/backed — simple, encrypted local backups from your browser",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:firefox": "tsc --noEmit && vite build --outDir dist-firefox && node scripts/finalize-firefox.mjs",
    "pack:chrome": "cd dist && zip -qr ../all-backed-chrome-v1.0.0.zip .",
    "pack:firefox": "cd dist-firefox && zip -qr ../all-backed-firefox-v1.0.0.zip .",
    "preview": "vite preview",
    "test": "node scripts/selftest-node.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
